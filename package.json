{
  "name": "@fjell/sample-app",
  "private": true,
  "version": "0.0.3",
  "description": "Sample Fjell Next.js Application with Widget and WidgetType models",
  "keywords": [
    "fjell",
    "nextjs",
    "sample",
    "sequelize",
    "reference"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:ui": "next dev",
    "build:server": "node build-server.js",
    "tsc:check": "tsc --noEmit",
    "dev:api": "npm run build:server && PORT=3001 node dist/index.js",
    "api:dev": "npm run build:server && PORT=3001 node dist/index.js",
    "api:build": "npm run build:server",
    "api:start": "PORT=3001 node dist/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run api:dev\"",
    "build": "npm run build:server && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf .next dist",
    "precommit": "npm run clean && npm run lint && npm run build && npm run test",
    "prepublishOnly": "npm run clean && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@fjell/cache": "^4.7.66",
    "@fjell/client-api": "^4.4.73",
    "@fjell/core": "^4.4.79",
    "@fjell/express-router": "^4.4.83",
    "@fjell/http-api": "^4.4.69",
    "@fjell/lib": "^4.4.89",
    "@fjell/lib-sequelize": "^4.4.85",
    "@fjell/logging": "^4.4.72",
    "@fjell/providers": "^4.5.91",
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.3",
    "express": "^5.2.1",
    "next": "^15.5.20",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-error-boundary": "^6.1.2",
    "react-router-dom": "^7.8.0",
    "sequelize": "^6.37.8",
    "source-map-support": "^0.5.21",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2",
    "util": "^0.12.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjellgrunn/sample-app.git"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@fjell/common-config": "^1.1.38",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.20",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
